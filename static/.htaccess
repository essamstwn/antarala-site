
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/futurinc/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/futurinc/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ===== Antarala =====
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2
AddDefaultCharset utf-8
AddCharset utf-8 .txt .xml .json

<IfModule mod_rewrite.c>
RewriteEngine On

# Paksa HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> tanpa www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- PINDAH DOMAIN: aktifkan 2 baris di bawah SETELAH https://antarala.co.id sudah bisa dibuka dengan SSL ----
# RewriteCond %{HTTP_HOST} ^antarala\.futurinc\.co\.id$ [NC]
# RewriteRule ^(.*)$ https://antarala.co.id/$1 [L,R=301]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s]
RewriteRule ^index\.html$ / [L,R=301]

# Halaman lama -> halaman baru
RewriteRule ^berita\.html$ /update.html [L,R=301]
RewriteRule ^artikel-opini(-[0-9]+)?\.html$ /opini.html [L,R=301]
RewriteRule ^artikel-feature(-[0-9]+)?\.html$ /feature.html [L,R=301]
RewriteRule ^artikel/kepala-4-mcr-masih-bikin-merinding\.html$ /artikel/konser-my-chemical-romance-jis-kepala-4.html [L,R=301]
</IfModule>

# Kompresi
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache browser
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType application/rss+xml "access plus 1 hour"
ExpiresByType application/json "access plus 1 hour"
ExpiresByType text/css "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(txt)$">
Header set X-Robots-Tag "noindex"
</FilesMatch>
</IfModule>
